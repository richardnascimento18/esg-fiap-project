# Copy to .env for local Docker Compose only; replace both example passwords.
MONGO_ROOT_USER=ecocity_root
MONGO_ROOT_PASSWORD=replace-with-local-root-password
MONGO_APP_USER=ecocity_app
MONGO_APP_PASSWORD=replace-with-local-app-password
API_PORT=8080
MONGO_PORT=27017
APP_SEED_DEMO_DATA=false
APP_EDITOR_USERNAME=editor
APP_EDITOR_PASSWORD=replace-with-local-editor-password
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-local-admin-password
